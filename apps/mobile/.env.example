# Copy to .env.local. Leave blank to run in offline Practice mode only.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public invite links (https://tideholm.app/invite/<code>) — falls back to tideholm://invite/<code>
EXPO_PUBLIC_INVITE_HOST=
# Optional: point at the Docker-free function server (see README)
EXPO_PUBLIC_FUNCTIONS_URL=
